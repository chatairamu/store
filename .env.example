# Environment variables for Orugallu Biryani Platform
# Copy this file to .env and fill in your actual credentials.

# Server Configuration
PORT=3000

# Database Configuration
DB_HOST=localhost
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=orugallu_biryani

# JWT Configuration
# Use a long, random, and secret string for the JWT secret
JWT_SECRET=your_super_secret_jwt_key
JWT_EXPIRES_IN=1d
