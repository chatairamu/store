<%- include('partials/header') %>
<%- include('partials/sidebar') %>

<h1 class="mt-4">Tag Management</h1>
<p class="lead">Create and manage product tags for the entire platform.</p>

<div class="row">
    <div class="col-md-8">
        <div class="card">
            <div class="card-header">Existing Tags</div>
            <div class="card-body">
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Name</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (tags.length > 0) { %>
                            <% tags.forEach(tag => { %>
                                <tr>
                                    <td><%= tag.id %></td>
                                    <td><%= tag.name %></td>
                                    <td>
                                        <button class="btn btn-sm btn-danger disabled">Delete</button>
                                    </td>
                                </tr>
                            <% }); %>
                        <% } else { %>
                            <tr>
                                <td colspan="3" class="text-center">No tags have been created yet.</td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card">
            <div class="card-header">Create New Tag</div>
            <div class="card-body">
                <form action="/admin/tags" method="POST">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <div class="mb-3">
                        <label for="name" class="form-label">Tag Name</label>
                        <input type="text" class="form-control" id="name" name="name" required>
                    </div>
                    <button type="submit" class="btn btn-primary">Create Tag</button>
                </form>
            </div>
        </div>
    </div>
</div>

<%- include('partials/footer') %>
