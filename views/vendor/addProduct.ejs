<%- include('partials/header') %>
<%- include('partials/sidebar') %>

<h1 class="mt-4">Add a New Product</h1>
<p class="lead">Fill out the form below to add a new product to your store.</p>

<form action="/vendor/products" method="POST" enctype="multipart/form-data">
    <div class="mb-3">
        <label for="name" class="form-label">Product Name</label>
        <input type="text" class="form-control" id="name" name="name" required>
    </div>
    <div class="mb-3">
        <label for="product_image" class="form-label">Product Image</label>
        <input class="form-control" type="file" id="product_image" name="product_image">
    </div>
    <div class="mb-3">
        <label for="description" class="form-label">Description</label>
        <textarea class="form-control" id="description" name="description" rows="3"></textarea>
    </div>
    <div class="row">
        <div class="col-md-6 mb-3">
            <label for="mrp" class="form-label">MRP (Maximum Retail Price)</label>
            <input type="number" class="form-control" id="mrp" name="mrp" step="0.01" required>
        </div>
        <div class="col-md-6 mb-3">
            <label for="sale_price" class="form-label">Sale Price</label>
            <input type="number" class="form-control" id="sale_price" name="sale_price" step="0.01" required>
        </div>
    </div>
    <div class="row">
        <div class="col-md-4 mb-3">
            <label for="stock" class="form-label">Stock Quantity</label>
            <input type="number" class="form-control" id="stock" name="stock" value="0" required>
        </div>
        <div class="col-md-4 mb-3">
            <label for="category_id" class="form-label">Category</label>
            <select class="form-select" id="category_id" name="category_id" required>
                <!-- In a real app, these would be populated from the database -->
                <option value="1">Biryani</option>
                <option value="2">Appetizers</option>
                <option value="3">Desserts</option>
            </select>
        </div>
    <div class="mb-3">
        <label for="tags" class="form-label">Tags</label>
        <select class="form-select" id="tags" name="tags" multiple>
            <% allTags.forEach(tag => { %>
                <option value="<%= tag.id %>"><%= tag.name %></option>
            <% }); %>
        </select>
        <small class="form-text text-muted">Hold Ctrl/Cmd to select multiple tags.</small>
    </div>
        <div class="col-md-4 mb-3">
            <label for="gst_slab_id" class="form-label">GST Slab</label>
            <select class="form-select" id="gst_slab_id" name="gst_slab_id" required>
                <!-- In a real app, these would be populated from the database -->
                <option value="1">No GST (0%)</option>
                <option value="2" selected>GST 5%</option>
                <option value="3">GST 12%</option>
                <option value="4">GST 18%</option>
                <option value="5">GST 28%</option>
            </select>
        </div>
    </div>
    <div class="row">
        <div class="col-md-6 mb-3">
            <label for="delivery_charge_override" class="form-label">Delivery Charge Override (₹)</label>
            <input type="number" class="form-control" id="delivery_charge_override" name="delivery_charge_override" step="0.01" placeholder="Leave blank for vendor default">
        </div>
        <div class="col-md-6 mb-3">
            <label for="packaging_charge_override" class="form-label">Packaging Charge Override (₹)</label>
            <input type="number" class="form-control" id="packaging_charge_override" name="packaging_charge_override" step="0.01" placeholder="Leave blank for vendor default">
        </div>
    </div>
    <hr>
    <h5>Promotional Pricing (Optional)</h5>
    <div class="row">
        <div class="col-md-4 mb-3">
            <label for="special_price" class="form-label">Special Price (₹)</label>
            <input type="number" class="form-control" id="special_price" name="special_price" step="0.01">
        </div>
        <div class="col-md-4 mb-3">
            <label for="special_price_start" class="form-label">Sale Start Date</label>
            <input type="datetime-local" class="form-control" id="special_price_start" name="special_price_start">
        </div>
        <div class="col-md-4 mb-3">
            <label for="special_price_end" class="form-label">Sale End Date</label>
            <input type="datetime-local" class="form-control" id="special_price_end" name="special_price_end">
        </div>
    </div>
    <button type="submit" class="btn btn-primary">Add Product</button>
    <a href="/vendor/products" class="btn btn-secondary">Cancel</a>
</form>

<%- include('partials/footer') %>
