<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> - Orugallu Biryani</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <%- include('partials/navbar') %>

    <div class="container mt-4">
        <div class="row">
            <div class="col-md-6">
                <!-- Product Image would go here -->
                <img src="/<%= product.image_path || 'images/placeholder.png' %>" class="img-fluid" alt="<%= product.name %>">
            </div>
            <div class="col-md-6">
                <h1><%= product.name %></h1>
                <p class="lead">By <%= product.vendor_name %></p>
                <p><strong>Rating:</strong> <%= averageRating.toFixed(1) %> / 5 (<%= reviews.length %> reviews)</p>
                <hr>
                <p><%= product.description %></p>
                <h3 class="my-3">₹<%= product.sale_price.toFixed(2) %> <small class="text-muted"><del>₹<%= product.mrp.toFixed(2) %></del></small></h3>
                <button class="btn btn-primary">Add to Cart</button>
            </div>
        </div>

        <hr class="my-4">

        <div class="row">
            <div class="col-md-7">
                <h3>Customer Reviews</h3>
                <% if (reviews.length > 0) { %>
                    <% reviews.forEach(review => { %>
                        <div class="card mb-3">
                            <div class="card-body">
                                <h5 class="card-title"><%= review.user_name %></h5>
                                <h6 class="card-subtitle mb-2 text-muted">Rating: <%= review.rating %> / 5</h6>
                                <p class="card-text"><%= review.comment %></p>
                                <small class="text-muted">Reviewed on <%= new Date(review.created_at).toLocaleDateString() %></small>
                            </div>
                        </div>
                    <% }); %>
                <% } else { %>
                    <p>This product has no reviews yet. Be the first to leave one!</p>
                <% } %>
            </div>
            <div class="col-md-5">
                <h3>Leave a Review</h3>
                <% if (user) { %>
                    <form id="review-form">
                        <div class="mb-3">
                            <label for="rating" class="form-label">Your Rating</label>
                            <select class="form-select" id="rating" name="rating" required>
                                <option value="">Select a rating...</option>
                                <option value="5">5 - Excellent</option>
                                <option value="4">4 - Very Good</option>
                                <option value="3">3 - Good</option>
                                <option value="2">2 - Fair</option>
                                <option value="1">1 - Poor</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label for="comment" class="form-label">Your Comment</label>
                            <textarea class="form-control" id="comment" name="comment" rows="3"></textarea>
                        </div>
                        <button type="submit" class="btn btn-primary">Submit Review</button>
                        <div id="review-message" class="mt-3"></div>
                    </form>
                <% } else { %>
                    <p><a href="/login">Log in</a> to leave a review.</p>
                <% } %>
            </div>
        </div>
    </div>

    <%- include('partials/footer') %>
    <script src="/js/reviews.js"></script>
</body>
</html>
