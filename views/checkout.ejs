<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Checkout - Orugallu Biryani</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
    <!-- Razorpay Checkout Script -->
    <script src="https://checkout.razorpay.com/v1/checkout.js"></script>
</head>
<body>
    <%- include('partials/navbar') %>

    <div class="container mt-4">
        <h1>Checkout</h1>
        <div class="row">
            <div class="col-md-8">
                <h4>Order Summary</h4>
                <div id="order-summary">
                    <!-- Cart items will be loaded here dynamically -->
                    <p>Loading your cart...</p>
                </div>
                <hr>
                <h5>Total: ₹<span id="total-amount">0.00</span></h5>
            </div>
            <div class="col-md-4">
                <h4>Payment</h4>
                <p>Click the button below to proceed with the payment.</p>
                <button id="pay-button" class="btn btn-success w-100">Pay with Razorpay</button>
                <div id="payment-message" class="mt-3"></div>
            </div>
        </div>
    </div>

    <%- include('partials/footer') %>
    <script src="/js/checkout.js"></script>
</body>
</html>
