<%- include('partials/header', { title: 'Checkout' }) %>

<div class="container mt-4">
    <h1>Checkout</h1>
    <div class="row">
        <div class="col-md-8">
            <h4>Order Summary</h4>
            <div id="order-summary">
                <!-- Cart items will be loaded here dynamically -->
                <p>Loading your cart...</p>
            </div>
            <hr>
            <h5>Total: ₹<span id="total-amount">0.00</span></h5>
        </div>
        <div class="col-md-4">
            <h4>Payment</h4>
            <p>Click the button below to proceed with the payment.</p>
            <button id="pay-button" class="btn btn-success w-100">Pay with Razorpay</button>
            <div id="payment-message" class="mt-3"></div>
        </div>
    </div>
</div>

<%- include('partials/footer') %>
<!-- Razorpay Checkout Script needs to be in the head, so I will move it -->
<script src="/js/checkout.js"></script>
