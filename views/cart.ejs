<%- include('partials/header', { title: 'Your Cart' }) %>

<div class="container mt-4">
    <h1>Your Shopping Cart</h1>
    <p>Update quantities or remove items from your cart in real-time.</p>

    <div class="row">
        <div class="col-md-8">
                <table class="table" id="cart-table" data-csrf-token="<%= csrfToken %>">
                <thead>
                    <tr>
                        <th>Product</th>
                        <th>Price</th>
                        <th>Quantity</th>
                        <th>Total</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    <!-- Cart items will be dynamically inserted here by cart.js -->
                    <tr><td colspan="5" class="text-center">Loading your cart...</td></tr>
                </tbody>
            </table>
        </div>
        <div class="col-md-4">
            <div class="card">
                <div class="card-body" id="cart-summary">
                    <!-- Cart summary will be dynamically inserted here -->
                    <p>Loading summary...</p>
                </div>
            </div>
        </div>
    </div>
</div>

<%- include('partials/footer') %>
<script src="/js/cart.js"></script>
