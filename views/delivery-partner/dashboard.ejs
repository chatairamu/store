<%- include('partials/header') %>
<%- include('partials/sidebar') %>

<h1 class="mt-4">Delivery Dashboard</h1>
<p class="lead">Welcome, <%= partner.name %>!</p>
<p>Here's a summary of your activity.</p>

<div class="row">
    <div class="col-md-6">
        <div class="card text-white bg-primary mb-3">
            <div class="card-header">Total Earnings</div>
            <div class="card-body">
                <h5 class="card-title">₹<%= totalEarnings.toFixed(2) %></h5>
                <p class="card-text">From all completed deliveries</p>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card text-white bg-success mb-3">
            <div class="card-header">Completed Deliveries</div>
            <div class="card-body">
                <h5 class="card-title"><%= completedDeliveries %></h5>
                <p class="card-text">All-time completed deliveries</p>
            </div>
        </div>
    </div>
</div>

<%- include('partials/footer') %>
